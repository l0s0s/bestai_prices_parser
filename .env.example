AI_API_KEY=
AI_BASE_URL=https://api.anthropic.com
# AI_PROVIDER selects the request protocol spoken to AI_BASE_URL — no code changes
# needed to switch model family, only .env. Supported values: glm | gemini | codex | claude
AI_PROVIDER=claude
AI_MODEL=claude-sonnet-5
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_MIN_CONFIDENCE=0.80

# --- Example: routing through the Jigji multi-model gateway ---
# AI_BASE_URL=https://jigji.com
# AI_API_KEY=<jigji-service-key>
# AI_PROVIDER=glm       AI_MODEL=glm-4.7                     # OpenAI-compatible Chat Completions
# AI_PROVIDER=gemini    AI_MODEL=gemini-2.5-flash            # OpenAI-compatible Chat Completions
# AI_PROVIDER=codex     AI_MODEL=gpt-5.6-terra                # OpenAI Responses API (streaming)
# AI_PROVIDER=claude    AI_MODEL=claude-haiku-4-5-20251001    # Anthropic Messages API

DATABASE_URL=sqlite:///data/bestai.db
SOURCES_FILE=config/sources.json
MODEL_ALIASES_FILE=config/model_aliases.json
OFFICIAL_PRICES_FILE=config/official_prices.json
EXTRACTION_PROMPT_FILE=config/extraction_prompt.txt
FX_RATES_FILE=config/fx_rates.json

FRONTEND_JSON_PATH=public/data/providers.json
REVIEW_CSV_PATH=exports/review_prices.csv
SNAPSHOTS_DIR=snapshots
LOG_DIR=logs

HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=3
PLAYWRIGHT_TIMEOUT_SECONDS=30
RDAP_TIMEOUT_SECONDS=10
